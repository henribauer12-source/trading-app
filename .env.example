# Vorlage. Echte Werte gehören NICHT hierher und NICHT ins Repo.
# Die echte Datei liegt unter ~/claude-local/trading-app/.env (chmod 600),
# außerhalb von Git und iCloud — siehe ADR-0003.
#
# Laden:  set -a && . ~/claude-local/trading-app/.env && set +a

# EODHD — Plan "Free": nur EOD, max. 1 Jahr Historie, 20 Calls/Tag.
# Intraday-Endpunkt antwortet mit HTTP 403.
EODHD_API_TOKEN=
